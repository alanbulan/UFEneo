{
  "schema": 1,
  "purpose": "图鉴像素形象的身高标尺：按原作设定身高换算原生像素站高，保证角色之间相对大小正确。",
  "convention": {
    "giant": {
      "reference_meters": 50,
      "reference_pixels": 192,
      "pixels_per_meter": 3.84,
      "min_pixels": 96,
      "max_pixels": 248,
      "applies_to_kinds": [
        "kaiju",
        "hero",
        "dark_ultra",
        "form",
        ""
      ],
      "note": "怪兽、奥特战士、黑暗巨人、形态统一按设定身高换算；超过 64.5 米的封顶到 248（画布根点上限），不足 25 米的托底到 96。"
    },
    "human": {
      "fixed_pixels": 140,
      "applies_to_kinds": [
        "story"
      ],
      "note": "剧情人物（人类）不按米换算——1.7 米按巨人标尺只有 6 像素。统一用固定站高，保证图鉴里人形可读。"
    }
  },
