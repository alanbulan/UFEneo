# Local runtimes and generated caches
.DS_Store
/.godot/
/.venv/
/.tools/
/.references/
/.claude/
/.cursor/
/.codex/
/.agent/
/addons/.godot_ai_update/
/builds/
/Godot/
**/__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Source-only Git repository: authoring art and binary media stay local on disk
/art/*
!/art/.gdignore
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.ico
*.ora
*.psd
*.wav
*.ogg
*.mp3
*.m4s
*.flac
*.aac
*.otf
*.ttf
*.woff
*.woff2

# Generated verification and recording output
/reports/**
!/reports/.gdignore
!/reports/README.md
/audio/work/
*.log
*.avi
*.mp4
*.mkv
*.tmp
*.bak
*.zip
*.7z

# Machine-only credentials and settings
.env
.env.*
*.dpapi
*.pem
*.key
/.vscode/
/.idea/

# Godot .uid and .import text sidecars remain tracked.
