# Local runtimes and generated caches
/.godot/
/.venv/
/.tools/
/.references/
/builds/
/Godot/
**/__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Generated verification and recording output
/reports/**
!/reports/.gdignore
!/reports/README.md
/audio/work/
*.log
*.avi
*.mp4
*.mkv
*.tmp
*.bak
*.zip
*.7z
# Machine-only credentials and settings
.env
.env.*
*.dpapi
*.pem
*.key
/.vscode/
/.idea/
/art/shared/locks/**
!/art/shared/locks/.gitkeep
# Godot .uid and .import sidecars are tracked.
